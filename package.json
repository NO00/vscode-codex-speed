{
  "name": "vscode-codex-speed",
  "displayName": "VSCode Codex Speed",
  "description": "Monitor Codex output token/s in the VS Code status bar, including Remote SSH. 在状态栏查看 Codex 输出速度。",
  "version": "0.1.2",
  "publisher": "NO00",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#101B2E",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NO00/vscode-codex-speed.git"
  },
  "homepage": "https://github.com/NO00/vscode-codex-speed#readme",
  "bugs": {
    "url": "https://github.com/NO00/vscode-codex-speed/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "ssh",
    "tokens",
    "speed"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexSpeed.showDetails",
        "title": "Codex Speed: 查看测速详情"
      },
      {
        "command": "codexSpeed.refresh",
        "title": "Codex Speed: 重新扫描日志"
      },
      {
        "command": "codexSpeed.openSettings",
        "title": "Codex Speed: 打开设置"
      },
      {
        "command": "codexSpeed.showLogs",
        "title": "Codex Speed: 查看诊断日志"
      }
    ],
    "configuration": {
      "title": "VSCode Codex Speed",
      "properties": {
        "codexSpeed.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Codex 日志测速。",
          "scope": "machine"
        },
        "codexSpeed.codexHome": {
          "type": "string",
          "default": "",
          "description": "当前扩展宿主上的 Codex 数据目录。空值依次使用 CODEX_HOME、~/.codex；支持 ~/。请填写 .codex 目录而非 sessions 子目录。",
          "scope": "machine"
        },
        "codexSpeed.scope": {
          "type": "string",
          "enum": [
            "all",
            "workspace"
          ],
          "default": "all",
          "enumDescriptions": [
            "汇总此主机的近期会话，包括子 agent。",
            "仅汇总 cwd 位于当前工作区中的会话。"
          ],
          "description": "选择需要统计的会话范围。",
          "scope": "machine"
        },
        "codexSpeed.pollIntervalMs": {
          "type": "integer",
          "default": 1000,
          "minimum": 500,
          "maximum": 10000,
          "description": "日志增量读取和状态栏刷新间隔（毫秒）。",
          "scope": "machine"
        },
        "codexSpeed.scanDays": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 30,
          "description": "扫描最近多少天的日期目录；仍会继续跟踪已发现的旧会话。",
          "scope": "machine"
        },
        "codexSpeed.showEstimates": {
          "type": "boolean",
          "default": true,
          "description": "生成中使用近期实测速率估算，并在数字前显示 ~。关闭后生成中等待新的实测记录。",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.1-5",
    "typescript": "5.7.3"
  }
}
