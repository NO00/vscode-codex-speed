{
  "name": "vscode-codex-speed",
  "displayName": "VSCode Codex Speed",
  "description": "%extension.description%",
  "version": "0.1.6",
  "publisher": "NO00",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#101B2E",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NO00/vscode-codex-speed.git"
  },
  "homepage": "https://github.com/NO00/vscode-codex-speed#readme",
  "bugs": {
    "url": "https://github.com/NO00/vscode-codex-speed/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "ssh",
    "tokens",
    "speed"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexSpeed.openDashboard",
        "title": "%command.openDashboard%"
      },
      {
        "command": "codexSpeed.showDetails",
        "title": "%command.showDetails%"
      },
      {
        "command": "codexSpeed.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "codexSpeed.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "codexSpeed.showLogs",
        "title": "%command.showLogs%"
      }
    ],
    "configuration": {
      "title": "VSCode Codex Speed",
      "properties": {
        "codexSpeed.usageRange": {
          "type": "string",
          "enum": ["30m", "today", "7d", "30d"],
          "enumDescriptions": ["%config.usageRange.30m%", "%config.usageRange.today%", "%config.usageRange.7d%", "%config.usageRange.30d%"],
          "default": "today",
          "description": "%config.usageRange%",
          "scope": "machine"
        },
        "codexSpeed.language": {
          "type": "string",
          "enum": ["auto", "en", "zh-cn", "zh-tw"],
          "enumDescriptions": ["%config.language.auto%", "English", "简体中文", "繁體中文"],
          "default": "auto",
          "description": "%config.language%",
          "scope": "machine"
        },
        "codexSpeed.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%",
          "scope": "machine"
        },
        "codexSpeed.codexHome": {
          "type": "string",
          "default": "",
          "description": "%config.codexHome%",
          "scope": "machine"
        },
        "codexSpeed.scope": {
          "type": "string",
          "enum": [
            "all",
            "workspace"
          ],
          "default": "all",
          "enumDescriptions": [
            "%config.scope.all%",
            "%config.scope.workspace%"
          ],
          "description": "%config.scope%",
          "scope": "machine"
        },
        "codexSpeed.pollIntervalMs": {
          "type": "integer",
          "default": 1000,
          "minimum": 500,
          "maximum": 10000,
          "description": "%config.pollIntervalMs%",
          "scope": "machine"
        },
        "codexSpeed.scanDays": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 30,
          "description": "%config.scanDays%",
          "scope": "machine"
        },
        "codexSpeed.showEstimates": {
          "type": "boolean",
          "default": true,
          "description": "%config.showEstimates%",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "package": "bash scripts/package.sh"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.7.3"
  }
}
